<Page x:Class="Reminder.Installer.Wizard.ParametersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Reminder.Installer"
      mc:Ignorable="d" 
      Title="Подготовка к установке"
      d:DesignHeight="100" d:DesignWidth="300"
      d:DataContext="{d:DesignInstance local:MainWindowViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Grid.Row="0" Text="Путь к папке установки" VerticalAlignment="Center"
                   Margin="0,5,0,5"/>
            <DockPanel LastChildFill="True">
                <Button ToolTip="Выбрать" Command="{Binding BrowseFolderCommand}" DockPanel.Dock="Right" >
                    <Image Source="/Resources/Folder.png" Height="16" Stretch="Uniform"/>
                </Button>
                <TextBox Text="{Binding InstallFolderPath}" IsReadOnly="True" VerticalContentAlignment="Center"/>
            </DockPanel>
            <CheckBox IsChecked="{Binding DesktopLink}" Content="Создать ярлык на рабочем столе"
                  Margin="0,15,0,0"/>
        </StackPanel>
        <Button Grid.Row="1" Content="Далее &gt;" HorizontalAlignment="Right" Command="{Binding NextSecretsCommand}"
                Padding="{StaticResource ButtonPadding}"/>
    </Grid>
</Page>
