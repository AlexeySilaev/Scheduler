<Page x:Class="Reminder.Installer.Wizard.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Reminder.Installer"
      mc:Ignorable="d" 
      Title="Все готово к установке"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:MainWindowViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Text="Идет процесс установки..." TextAlignment="Center" Visibility="{Binding InstallingVisibility}"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="{Binding InstallError}" TextAlignment="Center" Visibility="{Binding InstallErrorVisibility}"
                   Foreground="Red" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding BackParametersCommand}" Content="&lt; Назад" Padding="{StaticResource ButtonPadding}"/>
            <Button DockPanel.Dock="Right" Command="{Binding NextFinishCommand}" Content="Установить" Padding="{StaticResource ButtonPadding}"/>
        </DockPanel>
    </Grid>
</Page>
