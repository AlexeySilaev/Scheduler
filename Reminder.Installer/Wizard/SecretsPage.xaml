<Page x:Class="Reminder.Installer.Wizard.SecretsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Reminder.Installer"
      mc:Ignorable="d" 
      d:DesignHeight="250" d:DesignWidth="405"
      Loaded="Page_Loaded"
      Title="Доступ к секретам"
      d:DataContext="{d:DesignInstance local:MainWindowViewModel}">
    <Page.Resources>
        <FontFamily x:Key="passwordFont">pack://application:,,,/Resources/#password</FontFamily>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock  x:Name="sourceFont" Text="Пароль для разблокировки" VerticalAlignment="Center" Margin="0,5"/>
            <StackPanel Orientation="Horizontal" FocusManager.FocusedElement="{Binding ElementName=tbUnlockSecretsPassword}">
                <TextBox x:Name="tbUnlockSecretsPassword" MinWidth="345" VerticalContentAlignment="Center"
                       Text="{Binding UnlockSecretsPassword, UpdateSourceTrigger=PropertyChanged}"
                       FontFamily="{StaticResource passwordFont}" />
                <Image Source="{Binding EyeImage}" Stretch="None" VerticalAlignment="Center" Margin="2,0"
                       MouseLeftButtonDown="OnToggleShowPassword"/>
            </StackPanel>
            <TextBlock Text="Оставьте пустым, если не нужна группа секретов."  Margin="0,10,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Пароль не совпадает с предыдущим. Не забудьте его."
                   Visibility="{Binding PasswordTipVisibility}" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding BackParametersCommand}" Content="&lt; Назад" Padding="{StaticResource ButtonPadding}"/>
            <Button DockPanel.Dock="Right" Command="{Binding NextInstallCommand}" Content="Далее &gt;" Padding="{StaticResource ButtonPadding}"/>
        </DockPanel>

    </Grid>
</Page>
