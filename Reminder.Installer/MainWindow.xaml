<Window x:Class="Reminder.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reminder.Installer"
        mc:Ignorable="d"
        Title="Установка AV Reminder" 
        Height="200" Width="325" 
        Icon="/Install.png"
        ResizeMode="NoResize">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" TextAlignment="Center" FontSize="16"  Margin="0,5"/>
        <Frame Grid.Row="1"
            NavigationUIVisibility="Hidden" Source="/Wizard/ParametersPage.xaml" 
           Loaded="FrameworkElement_OnLoaded"
           Navigated="Frame_OnNavigated"/>
    </Grid>
</Window>
