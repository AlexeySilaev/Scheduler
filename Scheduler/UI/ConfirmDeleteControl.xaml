<UserControl x:Class="Scheduler.UI.ConfirmDeleteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Scheduler.UI"
             mc:Ignorable="d" 
             d:DesignHeight="410" d:DesignWidth="560"
             Background="{DynamicResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}"
             Opacity="0.95"
             d:DataContext="{d:DesignInstance local:ConfirmDeleteViewModel}">
    <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding Question, Mode=OneTime}" TextAlignment="Center" 
                       VerticalAlignment="Bottom" FontSize="16" Margin="10"/>
            <TextBlock Grid.Row="1" Text="{Binding SchedulerText, Mode=OneTime}" FontSize="14" FontWeight="DemiBold"
                       LineHeight="18" MaxHeight="72" TextWrapping="Wrap" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="50,10"/>
            <Grid Grid.Row="2" VerticalAlignment="Top" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Да" HorizontalAlignment="Right" MinWidth="50" Margin="10"
                        Command="{Binding YesCommand}" IsDefault="True"/>
                <Button Grid.Column="1" Content="Нет" HorizontalAlignment="Left" MinWidth="50" Margin="10" 
                        Command="{Binding NoCommand}" IsCancel="True"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
