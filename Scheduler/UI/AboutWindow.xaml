<Window x:Class="Scheduler.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:Scheduler.UI"
        mc:Ignorable="d"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Title="О программе" Height="185" Width="300"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Source="/Resources/app.png"
                   Width="90" Height="80" Margin="5,5,5,15"/>
            <TextBlock Grid.Column="1" Grid.Row="0" Text="Scheduler" FontSize="18"/>
            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Version, Mode=OneTime}"/>
            <TextBlock Grid.Column="1" Grid.Row="2" Text="Автор: Силаев Алексей"/>
            <TextBlock Grid.Column="1" Grid.Row="3">
                Поддержка:
                <Hyperlink NavigateUri="mailto:flownder@mail.ru" RequestNavigate="Hyperlink_OnRequestNavigate">flownder@mail.ru</Hyperlink>
            </TextBlock>
        </Grid>
        <TextBlock Grid.Row="1" Text="2024 г."/>
    </Grid>
</Window>
