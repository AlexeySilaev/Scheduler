<Window x:Class="Reminder.UnInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reminder.UnInstaller"
        mc:Ignorable="d"
        Title="Удаление AV Reminder" 
        Height="250" Width="405" 
        Icon="/App.ico"
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Все данные приложения будут удалены. Продолжить?" HorizontalAlignment="Center" />
        <Grid Grid.Row="1" VerticalAlignment="Center" IsEnabled="{Binding IsExportDataEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox Grid.ColumnSpan="2" Content = "Сделать резервную копию данных"  
                IsChecked="{Binding ExportData}" Margin="0,0,0,5"/>
            <TextBox Grid.Row="1" Text="{Binding ExportFilePath, Mode=OneWay}" IsReadOnly="True" Padding="1,2" VerticalAlignment="Center"/>
            <Button Grid.Row="1" Grid.Column="1" Command="{Binding SelectExportDataFileCommand}" Margin="5,0,0,0">
                <Image Source="/openfile24x24.png" Stretch="Uniform" Height="20" />
            </Button>
        </Grid>
        <UniformGrid Grid.Row="2" Columns="2">
            <Button Grid.Column="0" Content="Удалить" HorizontalAlignment="Center"
                Command="{Binding UninstallCommand}" IsDefault="True" Padding="5,2"/>
            <Button Grid.Column="1" Content="Отмена" HorizontalAlignment="Center"
                Command="{Binding CancelCommand}" IsCancel="True" Padding="5,2"/>
        </UniformGrid>
    </Grid>
</Window>
