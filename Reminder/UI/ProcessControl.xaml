<UserControl x:Class="Reminder.UI.ProcessControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:Reminder.Behaviors"
             xmlns:local="clr-namespace:Reminder.UI"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance local:ProcessViewModel}"
             d:DesignHeight="33" d:DesignWidth="250">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" behaviors:ImageBehavior.AnimatedSource="../Resources/processing24x24.gif" Stretch="None" Margin="5,0,10,0"/>
        <TextBlock Grid.Column="1" Text="{Binding ProcessName, Mode=OneTime}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
