<UserControl x:Class="Reminder.UI.UnlockSecretsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reminder.UI"
             mc:Ignorable="d" 
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             d:DataContext="{d:DesignInstance local:UnlockSecretsViewModel}"
             d:DesignHeight="430" d:DesignWidth="560">
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Для разблокировки секретов перейдите в" FontSize="16" VerticalAlignment="Center"/>
            <Button Grid.Row="1" MaxHeight="40" Command="{Binding ManagementCommand}" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <Image Source="/Resources/management24x24.png" Width="24" Height="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Управление" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
