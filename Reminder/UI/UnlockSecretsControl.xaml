<UserControl x:Class="Reminder.UI.UnlockSecretsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:attached="clr-namespace:Reminder.Attached"
             xmlns:local="clr-namespace:Reminder.UI"
             mc:Ignorable="d" 
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             d:DataContext="{d:DesignInstance local:UnlockSecretsViewModel}"
             d:DesignHeight="430" d:DesignWidth="560">
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Для разблокировки секретов перейдите в" FontSize="16" VerticalAlignment="Center"/>
            <Button Grid.Row="1" MinHeight="34" MaxHeight="34" Command="{Binding ManagementCommand}" 
                    attached:ButtonProperties.Image="../Resources/management24x24.png" Content="Управление"
                    Style="{StaticResource SelectedButtonStyle}" Margin="10,0,0,0" Padding="10,0"/>
        </StackPanel>
    </Grid>
</UserControl>
