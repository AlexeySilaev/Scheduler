<Window x:Class="Reminder.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:Reminder.UI"
        mc:Ignorable="d"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Title="О программе" Height="200" Width="335"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="6" Source="/Resources/About.png" Stretch="Uniform"
                   Width="128" Height="128" Margin="5" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="0" Text="AV Reminder" FontSize="18" TextAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="1" Text="Мечта склеротика" FontSize="16" TextAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding Version, Mode=OneTime}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="3" Text="Автор: Алексей Силаев" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="4" VerticalAlignment="Center">
                Поддержка:
                <Hyperlink NavigateUri="mailto:flownder@mail.ru" RequestNavigate="Hyperlink_OnRequestNavigate">flownder@mail.ru</Hyperlink>
            </TextBlock>
            <TextBlock Grid.Column="1" Grid.Row="5" Text="2024 г." VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
