<UserControl x:Class="Reminder.UI.WeekDaysControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Reminder.UI" 
             xmlns:converters="clr-namespace:Reminder.Converters"
             xmlns:vm="clr-namespace:Reminder.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:EventItemViewModel}"
             d:DesignHeight="265" d:DesignWidth="560">
    <UserControl.Resources>
        <converters:Log2IntToBoolConverter x:Key="Log2IntToBoolConverter"/>
        <converters:WeekDayToInvertBoolConverter x:Key="WeekDayToInvertBoolConverter"/>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Margin" Value="10,5,10,0"/>
        </Style>

    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Дни недели" TextAlignment="Center"/>
        <WrapPanel Orientation="Vertical" Height="50" HorizontalAlignment="Center">
            <CheckBox Content="Понедельник" IsChecked="{Binding WeekDays,
                Converter={StaticResource Log2IntToBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Monday}}"
                IsEnabled="{Binding EventDate,
                Converter={StaticResource WeekDayToInvertBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Monday}}"/>
            <CheckBox Content="Вторник" IsChecked="{Binding WeekDays,
                Converter={StaticResource Log2IntToBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Tuesday}}"
                IsEnabled="{Binding EventDate,
                Converter={StaticResource WeekDayToInvertBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Tuesday}}"/>
            <CheckBox Content="Среда" IsChecked="{Binding WeekDays,
                Converter={StaticResource Log2IntToBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Wednesday}}"
                IsEnabled="{Binding EventDate,
                Converter={StaticResource WeekDayToInvertBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Wednesday}}"/>
            <CheckBox Content="Четверг" IsChecked="{Binding WeekDays,
                Converter={StaticResource Log2IntToBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Thursday}}"
                IsEnabled="{Binding EventDate,
                Converter={StaticResource WeekDayToInvertBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Thursday}}"/>
            <CheckBox Content="Пятница" IsChecked="{Binding WeekDays,
                Converter={StaticResource Log2IntToBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Friday}}"
                IsEnabled="{Binding EventDate,
                Converter={StaticResource WeekDayToInvertBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Friday}}"/>
            <CheckBox Content="Суббота" IsChecked="{Binding WeekDays,
                Converter={StaticResource Log2IntToBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Saturday}}"
                IsEnabled="{Binding EventDate,
                Converter={StaticResource WeekDayToInvertBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Saturday}}"/>
            <CheckBox Content="Воскресенье" IsChecked="{Binding WeekDays,
                Converter={StaticResource Log2IntToBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Sunday}}"
                IsEnabled="{Binding EventDate,
                Converter={StaticResource WeekDayToInvertBoolConverter}, ConverterParameter={x:Static sys:DayOfWeek.Sunday}}"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
