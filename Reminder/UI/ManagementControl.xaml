<UserControl x:Class="Reminder.UI.ManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Reminder.Converters"
             xmlns:local="clr-namespace:Reminder.UI"
             xmlns:ui="clr-namespace:Reminder.UI"
             mc:Ignorable="d" 
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
             Loaded="UserControl_Loaded"
             d:DataContext="{d:DesignInstance local:ManagementViewModel}"
             d:DesignHeight="430" d:DesignWidth="560" >
    <UserControl.Resources>
        <Thickness x:Key="GroupBoxPadding" Left="10" Top="10" Right="10" Bottom="10"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:StringIsNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter"/>
        <converters:ProcessResultBrushConveter x:Key="ProcessResultBrushConveter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <GroupBox Header="Блокировка/разблокировка секретов" Padding="{StaticResource GroupBoxPadding}" Margin="0,0,0,10"
                  Visibility="{Binding ShowSecretsGroup, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
            <StackPanel Orientation="Horizontal" Height="{StaticResource OneLineElementsHeight}">
                <TextBlock Text="Пароль для секретов" VerticalAlignment="Center"/>
                <PasswordBox x:Name="tbSecretPassword" PasswordChanged="OnSecretsPasswordChanged" MinWidth="245" Margin="10,0,20,0" />
                <Button Content="Разблокировать" Command="{Binding LockOrUnlockSecrectsCommand}" Padding="5,0"
                        Visibility="{Binding AllowUnblock, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}"/>
                <Button Content="Заблокировать" Command="{Binding LockOrUnlockSecrectsCommand}" Padding="5,0"
                        Visibility="{Binding AllowUnblock, Converter={StaticResource InvertBoolToVisibilityConverter}, ConverterParameter=True}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Экспорт данных" Padding="{StaticResource GroupBoxPadding}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding ExportProcessDescription}" TextWrapping="Wrap" VerticalAlignment="Center"
                    Visibility="{Binding ExportData.IsProcessing, Converter={StaticResource InvertBoolToVisibilityConverter}, ConverterParameter=False}" />
                <Button Grid.Column="1" Content="Экспортировать" Padding="5,0" Height="{StaticResource OneLineElementsHeight}"
                    Visibility="{Binding ExportData.IsProcessing, Converter={StaticResource InvertBoolToVisibilityConverter}, ConverterParameter=False}"
                    Command="{Binding ExportCommand}"  Margin="{StaticResource Left5Margin}"/>
                <ui:ProcessControl DataContext="{Binding ExportData}" 
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"/>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2"  Orientation="Horizontal" HorizontalAlignment="Center"
                    DataContext="{Binding ExportData}" Margin="{StaticResource TextBlockMargin}">
                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumToStringConverter}}" FontSize="14"
                        Foreground="{Binding Status, Converter={StaticResource ProcessResultBrushConveter}}" />
                    <TextBlock Text="{Binding Time, Converter={StaticResource TimeSpanToStringConverter}}" FontSize="14"
                        Visibility="{Binding Status, Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter={x:Static local:ProcessResult.Ok}}" 
                        Foreground="{Binding Status, Converter={StaticResource ProcessResultBrushConveter}}" />
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Импорт данных" Padding="{StaticResource GroupBoxPadding}" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,5">
                    <TextBlock Text="Файл импорта" Margin="{StaticResource TextBlockMargin}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="True" VerticalAlignment="Center" Padding="1,2" 
                            Text="{Binding ImportFilePath, Mode=OneWay}" />
                        <Button Grid.Column="1" Command="{Binding SelectImportFileCommand}" Margin="{StaticResource Left5Margin}">
                            <Image Source="/Resources/openfile24x24.png" Stretch="Uniform" Height="20" />
                        </Button>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" IsEnabled="{Binding ImportFilePath, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" Margin="0,0,0,10">
                    <TextBlock Text="При совпадении данных" Margin="{StaticResource TextBlockMargin}"/>
                    <UniformGrid Columns="2">
                        <RadioButton IsChecked="{Binding SkipMatchingData}"
                            Content="Оставлять текущие данные" GroupName="MatchingData" />
                        <RadioButton Grid.Column="1"  IsChecked="{Binding SkipMatchingData, Converter= {StaticResource InvertBoolConverter}}"
                            Content="Заменять данными импорта" GroupName="MatchingData" />
                    </UniformGrid>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{Binding ImportProcessDescription}" TextWrapping="Wrap" VerticalAlignment="Center"
                    Visibility="{Binding ImportData.IsProcessing, Converter={StaticResource InvertBoolToVisibilityConverter}, ConverterParameter=False}" />
                <Button Grid.Column="1" Grid.Row="2" Content="Импортировать" Padding="5,0" Height="{StaticResource OneLineElementsHeight}"
                    Visibility="{Binding ImportData.IsProcessing, Converter={StaticResource InvertBoolToVisibilityConverter}, ConverterParameter=False}"
                    Command="{Binding ImportCommand}"  Margin="{StaticResource Left5Margin}" />
                <ui:ProcessControl Grid.Row="2" DataContext="{Binding ImportData}" 
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"/>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2"  Orientation="Horizontal" HorizontalAlignment="Center"
                    DataContext="{Binding ImportData}" Margin="{StaticResource TextBlockMargin}">
                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumToStringConverter}}" FontSize="14" 
                        Foreground="{Binding Status, Converter={StaticResource ProcessResultBrushConveter}}"/>
                    <TextBlock Text="{Binding Time, Converter={StaticResource TimeSpanToStringConverter}}" FontSize="14"
                        Visibility="{Binding Status, Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter={x:Static local:ProcessResult.Ok}}"
                        Foreground="{Binding Status, Converter={StaticResource ProcessResultBrushConveter}}" />
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
