<UserControl x:Class="Reminder.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reminder.UI"
             xmlns:converters="clr-namespace:Reminder.Converters"
             xmlns:models="clr-namespace:Reminder.Models"
             mc:Ignorable="d" 
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
             d:DesignHeight="410" d:DesignWidth="560"
             d:DataContext="{d:DesignInstance local:SettingsViewModel}"
             DataContextChanged="SettingsControl_OnDataContextChanged">
    <UserControl.Resources>
        <Thickness x:Key="GroupMargin" Left="5" Top="5" Right="5" Bottom="5" />
        <Thickness x:Key="StackPanelMargin" Left="10" Top="10" Right="10" Bottom="10" />
        <PathGeometry x:Key="Triangle">
            <PathFigure IsClosed="True" StartPoint="1,1">
                <LineSegment Point="10, 6" />
                <LineSegment Point = "1, 10" />
            </PathFigure>
        </PathGeometry>
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="Запуск приложения" Margin="{StaticResource GroupMargin}">
            <StackPanel Margin="{StaticResource StackPanelMargin}">
                <CheckBox IsChecked="{Binding LaunchWithWindows}" 
                          Content="Запускать вместе с Windows" />
                <CheckBox IsChecked="{Binding MinimizeToTray}"
                          Content="Минимизировать в системный лоток" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Расположение окна уведомлений" Margin="{StaticResource GroupMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="{StaticResource StackPanelMargin}">
                    <RadioButton IsChecked="{Binding NotificationsWindowPosition, Converter={StaticResource EnumToBoolConverter},
                    ConverterParameter={x:Static models:NotificationsWindowPosition.RightBottom}}" 
                    Content="Нижний правый угол" GroupName="NotificationPosition" />
                    <RadioButton IsChecked="{Binding NotificationsWindowPosition, Converter={StaticResource EnumToBoolConverter},
                    ConverterParameter={x:Static models:NotificationsWindowPosition.Center}}"
                             Content="В центре экрана" GroupName="NotificationPosition" Margin="0,5,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding TopMostNotificationsWindow}" Margin="0,10,0,0"
                          Content="Поверх всех окон"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Звуковое сопровождение уведомлений" Margin="{StaticResource GroupMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <RadioButton IsChecked="{Binding RingtoneMode, Converter={StaticResource EnumToBoolConverter},
                    ConverterParameter={x:Static models:RingtoneMode.Default}}" Margin="{StaticResource StackPanelMargin}"
                             Content="По умолчанию" GroupName="RingtoneMode" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="{StaticResource StackPanelMargin}" Orientation="Horizontal">
                    <RadioButton IsChecked="{Binding RingtoneMode, Converter={StaticResource EnumToBoolConverter},
                    ConverterParameter={x:Static models:RingtoneMode.NoSound}}" 
                                 Content="Выключить звук" GroupName="RingtoneMode" />
                    <RadioButton IsChecked="{Binding RingtoneMode, Converter={StaticResource EnumToBoolConverter},
                    ConverterParameter={x:Static models:RingtoneMode.SpeechSynthesizer}}" 
                                 Content="Озвучить текст" GroupName="RingtoneMode"
                                 Margin="15,0,0,0"/>
                </StackPanel>
                <RadioButton Grid.Row="1" IsChecked="{Binding RingtoneMode, Converter={StaticResource EnumToBoolConverter},
                    ConverterParameter={x:Static models:RingtoneMode.Custom}}" 
                             Margin="10,0,0,5"
                             Content="Выбрать файл" GroupName="RingtoneMode"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5,-2,0,10"
                            IsEnabled="{Binding RingtoneMode, Converter={StaticResource EnumToBoolConverter},
                            ConverterParameter={x:Static models:RingtoneMode.Custom}}" 
                            VerticalAlignment="Bottom" >
                    <Popup StaysOpen="False" Placement="Top" PlacementTarget="{Binding ElementName=ShowFileBox}"
                           AllowsTransparency="True" IsOpen="{Binding IsErrorTestPlay}" PopupAnimation="Scroll" >
                        <Border BorderBrush="DarkRed" BorderThickness="1" Background="LightPink">
                            <TextBlock TextWrapping="Wrap" Width="150" Opacity="0.8" 
                                   Text ="Не удается воспроизвести указанный файл" Margin="2"/>
                        </Border>
                    </Popup>
                    <TextBox Text="{Binding CustomSoundFilePath}" x:Name="ShowFileBox"
                             IsReadOnly="True" Width="300" ToolTip="{Binding IsErrorTestPlay}" />
                    <Button Content="..." Command="{Binding SelectCustomFileCommand}" 
                            Margin="2,0" Padding="2,0"/>
                    <Button Command="{Binding TestPlayFileCommand}">
                        <Path Data="{StaticResource Triangle}" Fill="Green" />
                    </Button>
                    <MediaElement LoadedBehavior="Manual" x:Name="Media"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="3" Header="Удаление уведомлений" Margin="{StaticResource GroupMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="{StaticResource StackPanelMargin}">
                    <RadioButton IsChecked="{Binding DeleteReminderItemsMode, Converter={StaticResource EnumToBoolConverter},
                    ConverterParameter={x:Static models:DeleteReminderItemsMode.Immediately}}" 
                             Content="Без подтверждения" GroupName="DeleteMode"/>
                    <RadioButton IsChecked="{Binding DeleteReminderItemsMode, Converter={StaticResource EnumToBoolConverter},
                    ConverterParameter={x:Static models:DeleteReminderItemsMode.Confirm}}"
                             Content="С подтверждением" GroupName="DeleteMode" Margin="0,5,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding DeleteCompletedReminders}" Margin="0,10,0,0"
                          Content="Автоматически удалять завершенные"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="4" Header="Предупреждение о событиях заранее" Margin="{StaticResource GroupMargin}">
            <CheckBox  IsChecked="{Binding ShowComingDayAboutEvents}" Margin="{StaticResource StackPanelMargin}"
                      Content="За сутки предупредить о наступлении"/>
        </GroupBox>
    </Grid>
</UserControl>
