<Window x:Class="Reminder.UI.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:Reminder.UI"
        xmlns:behaviors="clr-namespace:Reminder.Behaviors"
        xmlns:converters="clr-namespace:Reminder.Converters"
        xmlns:viewModels="clr-namespace:Reminder.ViewModels"
        xmlns:templateSelectors="clr-namespace:Reminder.TemplateSelectors"
        mc:Ignorable="d" 
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Уведомление" Height="285" Width="460" 
        Topmost="{Binding TopMost, Mode=OneTime}">
    <Window.DataContext>
        <ui:ReminderWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <templateSelectors:PostponeItemTemplateSelector x:Key="PostponeItemTemplateSelector"/>
        <converters:PostponeDescriptionConverter x:Key="PostponeDescriptionConverter"/>
        <converters:ReminderItemPostponeItemsSourceConverter x:Key="ReminderItemPostponeItemsSourceConverter" />
    </Window.Resources>
    <Grid PreviewMouseLeftButtonDown="OnBeforeMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>


        <MediaElement LoadedBehavior="Manual" x:Name="Media"/>

        <TextBlock Grid.Row="0"  Grid.Column="1" Margin="10,10" Foreground="{StaticResource Introductory}"
                   Visibility="{Binding TipVisibility}"
                   Text="Вновь возникающие уведомления будут добавлены в общий список." TextAlignment="Center"  TextWrapping="Wrap"/>

        <Image Grid.Row="1" Grid.Column="0" behaviors:ImageBehavior.AnimatedSource="../Resources/reminder.gif" Stretch="None"/>

        <ScrollViewer Grid.Column="1"  Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Items}" Margin="10" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:TimerReminderItem}">
                        <Border BorderThickness="0 0 0 1" BorderBrush="{StaticResource GrayText}" >
                            <Grid Margin="5" PreviewMouseLeftButtonDown="OnTimerReminderItem_PreviewMouseLeftButtonDown">  
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Source.Text}" FontSize="14" FontWeight="DemiBold"
                                           LineHeight="18" MaxHeight="36" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="{Binding Source.Type, Converter={StaticResource EnumToStringConverter}}" Foreground="{StaticResource GrayText}"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding  ReminderDateTime,  StringFormat='dd.MM HH:mm'}"
                                           Foreground="{StaticResource GrayText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5">
                                    <TextBlock Text ="Повтор" VerticalAlignment="Center"/>
                                    <Grid Width="75" Margin="5,0">
                                        <ComboBox IsEditable="False"
                                            ItemTemplateSelector="{StaticResource PostponeItemTemplateSelector}"
                                            Visibility="{Binding AllowPostpone, Converter={StaticResource InvertBoolToVisibilityConverter}, ConverterParameter=False}"
                                            ItemsSource="{Binding Source, Converter={StaticResource ReminderItemPostponeItemsSourceConverter}}"
                                            SelectedItem="{Binding Postpone}"/>
                                        <TextBlock VerticalAlignment="Center"
                                            Text="{Binding Postpone, Converter={StaticResource PostponeDescriptionConverter}}"
                                            Visibility="{Binding AllowPostpone, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
