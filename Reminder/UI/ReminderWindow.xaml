<Window x:Class="Reminder.UI.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:Reminder.UI"
        xmlns:viewModels="clr-namespace:Reminder.ViewModels"
        xmlns:converters="clr-namespace:Reminder.Converters"
        mc:Ignorable="d" 
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Уведомление" Height="285" Width="460" 
        Topmost="{Binding TopMost, Mode=OneTime}">
    <Window.DataContext>
        <ui:ReminderWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <MediaElement LoadedBehavior="Manual" x:Name="Media"/>

        <TextBlock Grid.Row="0"  Grid.Column="1" Margin="10,10" Foreground="{StaticResource GrayText}"
                   Text="Вновь возникающие уведомления будут добавлены в общий список." TextAlignment="Center"  TextWrapping="Wrap"/>

        <ui:GifImage Grid.Row="1" Grid.Column="0" Stretch="None" Margin="12,12,0,0" 
                          GifSource="/Resources/reminder.gif" AutoStart="True"/>
        <ScrollViewer Grid.Column="1"  Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Items}" Margin="10" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ReminderItemViewModel}">
                        <Border BorderThickness="0 0 0 1" BorderBrush="{StaticResource GrayText}" >
                            <Grid Margin="5" >  
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="DemiBold"
                                           LineHeight="18" MaxHeight="36" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="{Binding Type, Converter={StaticResource EnumToStringConverter}}"
                                       Foreground="{StaticResource GrayText}" Margin="5" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5"
                                                    Visibility="{Binding IsOneTimeReminder, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}">
                                    <TextBlock Text ="Повтор" VerticalAlignment="Center" IsEnabled="{Binding AllowPostpone}"/>
                                    <Grid Width="70" Margin="5,0">
                                        <ComboBox IsEditable="False"  
                                                  Visibility="{Binding AllowPostpone, Converter={StaticResource InvertBoolToVisibilityConverter}, ConverterParameter=False}"
                                                  ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}, 
                                                           Path=DataContext.PostponeItems}" SelectedItem="{Binding Postpone}"/>
                                        <TextBlock Text="{Binding PostponeDescription}" VerticalAlignment="Center"
                                            Visibility="{Binding AllowPostpone, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"/>

                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding PeriodicityDescription}" 
                                               Visibility="{Binding IsOneTimeReminder, Converter={StaticResource InvertBoolToVisibilityConverter}, ConverterParameter=False}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GrayText}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
