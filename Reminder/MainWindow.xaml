<Window x:Class="Reminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Reminder.ViewModels"
        xmlns:converters="clr-namespace:Reminder.Converters"
        xmlns:templateSelectors="clr-namespace:Reminder.TemplateSelectors"
        xmlns:ui="clr-namespace:Reminder.UI"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Мечта склеротика" 
        Left="{Binding MainWindowLeft, Mode=TwoWay}"
        Top="{Binding MainWindowTop, Mode=TwoWay}"
        Height="{Binding MainWindowHeight, Mode=TwoWay}" 
        MinWidth="{Binding MainWindowWidth, Mode=OneTime}" 
        MaxWidth="{Binding MainWindowWidth, Mode=OneTime}" 
        MinHeight="{Binding MainWindowMinHeight, Mode=OneTime}" 
        Icon="/App.ico">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <converters:FoundItemsCountConverter x:Key="FoundItemsCountConverter"/>
        <templateSelectors:ReminderItemTemplateSelector
            AlarmTemplate="{StaticResource AlarmItemTemplate}"
            EventTemplate="{StaticResource EventItemTemplate}"
            NoteTemplate="{StaticResource NoteItemTemplate}"
            ProjectTemplate="{StaticResource ProjectItemTemplate}"
            SecretTemplate="{StaticResource SecretItemTemplate}"
            x:Key="ReminderItemTemplateSelector"/>
        <templateSelectors:ReminderItemTemplateSelector
            AlarmTemplate="{StaticResource EditAlarmItemTemplate}"
            EventTemplate="{StaticResource EditEventItemTemplate}"
            NoteTemplate="{StaticResource EditNoteItemTemplate}"
            ProjectTemplate="{StaticResource EditProjectItemTemplate}"
            SecretTemplate="{StaticResource EditSecretItemTemplate}"
            x:Key="EditorItemTemplateSelector"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="OrangeRed">
            <TextBlock Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="10"/>
            <!-- Системный лоток -->
            <ui:FrameworkNotifyIcon NotifyRequest="{Binding NotifyIconHandler.NotifyRequest}"
                                    IconVisible="{Binding NotifyIconHandler.IsIconVisible}" Text="Мечта склеротика">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="OpenSelected">
                        <b:InvokeCommandAction Command="{Binding NotifyIconHandler.NotifyIconOpenCommand}"/>
                    </b:EventTrigger>
                    <b:EventTrigger EventName="AboutSelected">
                        <b:InvokeCommandAction Command="{Binding NotifyIconHandler.NotifyIconAboutCommand}"/>
                    </b:EventTrigger>
                    <b:EventTrigger EventName="ExitSelected">
                        <b:InvokeCommandAction Command="{Binding NotifyIconHandler.NotifyIconExitCommand}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ui:FrameworkNotifyIcon>
            <!-- Предупреждения о грядущих событиях -->
            <Popup StaysOpen="True" Placement="Absolute" PlacementRectangle="{Binding PopupRect}"
                   IsOpen="{Binding IsShowComingDayAboutEvents}" >
                <ui:ComingDayEventsControl DataContext="{Binding ComingDayEvents}"/>
            </Popup>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox  Grid.Column="0" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <Image Width="32" Height="32" Source="{Binding Path=ImagePath}" />
                            <TextBlock FontSize="16" VerticalAlignment="Center" Margin="5,0" Text="{Binding Path=Name}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="1" MinHeight="40" Command="{Binding SettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/settings32x32.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        <!-- Список элементов / панель редактирования -->
        <ui:ShiftControl Grid.Row="1" Grid.Column="1" IsShifted="{Binding IsShifted}"
                         IsShiftedChangedCompleted="ShiftControl_OnIsShiftedChangedCompleted">
            <ui:ShiftControl.LeftContent>
                <!-- Список -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="5"
                       FocusManager.FocusedElement="{Binding ElementName=FilterBox}">
                        <TextBlock Text="{Binding SelectedGroup.Description}" TextWrapping="Wrap" TextAlignment="Center"
                            Height="36" Margin="10,5, 10, 10" DockPanel.Dock="Top" Foreground="{StaticResource Introductory}"
                            Visibility="{Binding IntroductoryMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Поиск" Margin="5,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SearchText, Delay=500, UpdateSourceTrigger=PropertyChanged}" MinWidth="310"
                                 VerticalContentAlignment="Center" x:Name="FilterBox"/>
                            <TextBlock Text="{Binding SelectedGroup.Items, Converter={StaticResource FoundItemsCountConverter}}"
                                 Margin="5,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Command="{Binding AddItemCommand}" DockPanel.Dock="Right" Height="{StaticResource OneLineElementsHeight}"> 
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Добавить" Margin="5,0" VerticalAlignment="Center"/>
                                <Path Stroke="Black" StrokeThickness="2" Data="M 7,2 L 7,14 M 1,8 L 13,8" Margin="0,0,5,0"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <ListBox Grid.Row="1" Margin="5"
                             ItemsSource="{Binding SelectedGroup.Items}"
                             SelectedValue="{Binding SelectedItem}"
                             ItemTemplateSelector="{StaticResource ReminderItemTemplateSelector}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <ui:ConfirmDeleteControl Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding ConfirmDelete}"
                            Visibility="{Binding Path=DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                </Grid>
            </ui:ShiftControl.LeftContent>
            <ui:ShiftControl.RightContent>
                <!-- Редактирование элемента -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="15,5">
                        <Button Content=" &lt; Отмена " DockPanel.Dock="Left" Height="{StaticResource OneLineElementsHeight}"
                                Command="{Binding CancelEditItemCommand}" IsCancel="True"/>
                        <Button Command="{Binding SaveItemCommand}" DockPanel.Dock="Right" Height="{StaticResource OneLineElementsHeight}">
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="Сохранить" Margin="5,0" VerticalAlignment="Center"/>
                                <Image Source="/Resources/save.png" Width="16" Height="16"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <ContentControl Grid.Row="1" Margin="5"  
                                    ContentTemplateSelector="{StaticResource EditorItemTemplateSelector}" 
                                    Content="{Binding EditingItem}"/>
                    <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                            BorderThickness="1" Margin="{StaticResource DetailsMargin}"
                            Visibility="{Binding ValidationWarning, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding ValidationWarning}" 
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="10"
                                   Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"/>
                    </Border>
                </Grid>
            </ui:ShiftControl.RightContent>
        </ui:ShiftControl>
        <ui:SettingsControl Grid.Row="1" Grid.Column="1" DataContext="{Binding Settings}"
                Visibility="{Binding Path=DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource NotNullToVisibilityConverter}}"/>

    </Grid>
</Window>
