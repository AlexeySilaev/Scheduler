<Window x:Class="Reminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Reminder.ViewModels"
        xmlns:templateSelectors="clr-namespace:Reminder.TemplateSelectors"
        xmlns:ui="clr-namespace:Reminder.UI"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Напоминалка" Height="450" 
        MinWidth="730" MaxWidth="730"
        MinHeight="405"
        Icon="/Resources/About.png">
    <Window.DataContext>
        <vm:MainViewModel></vm:MainViewModel>
    </Window.DataContext>
    <Window.Resources>
        <templateSelectors:ReminderItemTemplateSelector
            AlarmTemplate="{StaticResource AlarmItemTemplate}"
            EventTemplate="{StaticResource EventItemTemplate}"
            NoteTemplate="{StaticResource NoteItemTemplate}"
            x:Key="ReminderItemTemplateSelector"/>
        <templateSelectors:ReminderItemTemplateSelector
            AlarmTemplate="{StaticResource EditAlarmItemTemplate}"
            EventTemplate="{StaticResource EditEventItemTemplate}"
            NoteTemplate="{StaticResource EditNoteItemTemplate}"
            x:Key="EditorItemTemplateSelector"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Background="OrangeRed">
            <TextBlock Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="10"/>
            <ui:FrameworkNotifyIcon NotifyRequest="{Binding NotifyIconHandler.NotifyRequest}"
                                    IconVisible="{Binding NotifyIconHandler.IsIconVisible}" Text="Напоминалка">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="OpenSelected">
                        <b:InvokeCommandAction Command="{Binding NotifyIconHandler.NotifyIconOpenCommand}"/>
                    </b:EventTrigger>
                    <b:EventTrigger EventName="AboutSelected">
                        <b:InvokeCommandAction Command="{Binding NotifyIconHandler.NotifyIconAboutCommand}"/>
                    </b:EventTrigger>
                    <b:EventTrigger EventName="ExitSelected">
                        <b:InvokeCommandAction Command="{Binding NotifyIconHandler.NotifyIconExitCommand}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ui:FrameworkNotifyIcon>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox  Grid.Column="0" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <Image Width="32" Height="32" Source="{Binding Path=ImagePath}" />
                            <TextBlock FontSize="16" VerticalAlignment="Center" Margin="5,0" Text="{Binding Path=Name}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="1" MinHeight="40" Command="{Binding SettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/settings32x32.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        <!-- Список элементов / панель редактирования -->
        <ui:ShiftControl Grid.Row="1" Grid.Column="1" IsShifted="{Binding EditingItem, Converter={StaticResource NotNullToBoolConverter}}">
            <ui:ShiftControl.LeftContent>
                <!-- Список -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="5"
                       FocusManager.FocusedElement="{Binding ElementName=FilterBox}">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Поиск вхождений" Margin="5,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SearchText, Delay=500, UpdateSourceTrigger=PropertyChanged}" MinWidth="300"
                             VerticalContentAlignment="Center" x:Name="FilterBox"/>
                        </StackPanel>
                        <Button Command="{Binding AddItemCommand}" DockPanel.Dock="Right" Height="24"> 
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="Добавить" Margin="5,0" VerticalAlignment="Center"/>
                                <Image Source="/Resources/add20x20.png"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <ListBox Grid.Row="1" Margin="5" 
                             ItemsSource="{Binding SelectedGroup.Items}"
                             SelectedValue="{Binding SelectedItem}"
                             ItemTemplateSelector="{StaticResource ReminderItemTemplateSelector}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <ui:ConfirmDeleteControl Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding ConfirmDelete}"
                            Visibility="{Binding Path=DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                </Grid>
            </ui:ShiftControl.LeftContent>
            <ui:ShiftControl.RightContent>
                <!-- Редактирование элемента -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="5">
                        <Button Content=" &lt; Отмена " DockPanel.Dock="Left" Height="24"
                                Command="{Binding CancelEditItemCommand}" IsCancel="True"/>
                        <Button Command="{Binding SaveItemCommand}" DockPanel.Dock="Right" Height="24">
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="Сохранить" Margin="5,0" VerticalAlignment="Center"/>
                                <Image Source="/Resources/save.png" Width="16" Height="16"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <ContentControl Grid.Row="1" Margin="5"  
                                    ContentTemplateSelector="{StaticResource EditorItemTemplateSelector}" 
                                    Content="{Binding EditingItem}"/>
                    <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                            BorderThickness="1" Margin="{StaticResource DetailsMargin}"
                            Visibility="{Binding ValidationWarning, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding ValidationWarning}" 
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="10"
                                   Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"/>
                    </Border>
                </Grid>
            </ui:ShiftControl.RightContent>
        </ui:ShiftControl>
        <ui:SettingsControl Grid.Row="1" Grid.Column="1" DataContext="{Binding Settings}"
                Visibility="{Binding Path=DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource NotNullToVisibilityConverter}}"/>

    </Grid>
</Window>
